{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "schedule": ["before 6am on monday"],
  "timezone": "Europe/Berlin",
  "platformAutomerge": true,
  "packageRules": [
    {
      "description": "Patch and minor updates (npm, mise, GitHub Actions) merge by themselves once CI is green",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "non-major dependencies",
      "automerge": true
    },
    {
      "description": "Major updates in their own PRs, merged by themselves once CI is green (CI cannot see visual changes in rendered diagrams)",
      "matchUpdateTypes": ["major"],
      "automerge": true,
      "labels": ["major-update"]
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  }
}
